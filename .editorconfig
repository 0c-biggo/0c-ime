root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{tsv,csv}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

[*.go]
indent_style = tab

# Windows PowerShell 5.1 requires the BOM for Chinese source text.
[*.ps1]
charset = utf-8-bom
